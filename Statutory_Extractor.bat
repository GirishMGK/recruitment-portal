@echo off
REM ===================================================================
REM   Statutory Compliance Extractor  --  one-click launcher
REM   ESI - PT - TDS (ITNS 281) - GSTR-1 - GSTR-3B
REM
REM   Just double-click this file. On the first run it sets up a
REM   private Python environment and installs everything it needs;
REM   after that it simply starts the app and opens your browser.
REM
REM   The Python app is EMBEDDED at the bottom of this file, so this
REM   single .bat works on its own. If a "statutory_extractor.py"
REM   file sits next to it, that copy is used instead (easy to edit).
REM ===================================================================
setlocal EnableExtensions EnableDelayedExpansion
title Statutory Compliance Extractor
cd /d "%~dp0"

echo ==================================================
echo    Statutory Compliance Extractor - Launcher
echo ==================================================
echo.

REM ---------- 1. Locate a Python interpreter ----------
set "PYEXE="
where py >nul 2>&1 && set "PYEXE=py -3"
if not defined PYEXE (
    where python >nul 2>&1 && set "PYEXE=python"
)
if not defined PYEXE (
    echo [ERROR] Python was not found on this PC.
    echo.
    echo   Please install Python 3.9 or newer from:
    echo       https://www.python.org/downloads/
    echo   IMPORTANT: tick "Add Python to PATH" during installation.
    echo.
    pause
    exit /b 1
)
echo [OK] Python found.

REM ---------- 2. Make sure the app file exists ----------
set "APP=%~dp0statutory_extractor.py"
if not exist "%APP%" (
    echo [INFO] Extracting the embedded application...
    call :DECODE_APP
    if not exist "%APP%" (
        echo [ERROR] Could not extract the embedded application.
        pause
        exit /b 1
    )
)
echo [OK] Application ready.

REM ---------- 3. Create a private virtual environment (first run only) ----------
set "VENV=%~dp0.venv"
if not exist "%VENV%\Scripts\python.exe" (
    echo [SETUP] Creating a private Python environment ^(first run only^)...
    %PYEXE% -m venv "%VENV%"
    if errorlevel 1 (
        echo [ERROR] Failed to create the virtual environment.
        pause
        exit /b 1
    )
)
set "VPY=%VENV%\Scripts\python.exe"

REM ---------- 4. Install dependencies if missing ----------
"%VPY%" -c "import streamlit, pandas, fitz, openpyxl" >nul 2>&1
if errorlevel 1 (
    echo [SETUP] Installing required packages. This can take a few minutes...
    "%VPY%" -m pip install --upgrade pip
    "%VPY%" -m pip install streamlit pandas pymupdf openpyxl
    if errorlevel 1 (
        echo [ERROR] Failed to install required packages.
        echo         Check your internet connection and try again.
        pause
        exit /b 1
    )
)
echo [OK] All packages installed.

REM ---------- 5. Launch the app (opens your browser) ----------
echo.
echo --------------------------------------------------
echo  Starting the app - your browser will open shortly.
echo  Keep THIS window open while you use the app.
echo  Close this window when you are done to stop it.
echo --------------------------------------------------
echo.
"%VPY%" -m streamlit run "%APP%"

echo.
echo App stopped.
pause
exit /b 0

REM ===================================================================
REM  Sub-routine: decode the embedded Base64 app to statutory_extractor.py
REM  The marker below is split in this command so it matches ONLY the
REM  real data line at the end of the file (not this line itself).
REM ===================================================================
:DECODE_APP
powershell -NoProfile -ExecutionPolicy Bypass -Command ^
  "$lines = Get-Content -LiteralPath '%~f0';" ^
  "$marker = '#####APP' + '_BASE64#####';" ^
  "$idx = [Array]::IndexOf($lines, $marker);" ^
  "if ($idx -lt 0) { exit 1 }" ^
  "$b64 = ($lines[($idx+1)..($lines.Length-1)] -join '');" ^
  "[IO.File]::WriteAllBytes('%APP%', [Convert]::FromBase64String($b64))"
exit /b

REM Everything after the marker line below is the Base64-encoded app.
#####APP_BASE64#####

